{
  "name": "get-shit-right",
  "version": "0.5.0",
  "description": "GSR \u2014 PRD-first, human-in-the-loop workflow for building production apps with Claude Code",
  "scripts": {
    "check": "npm run check:js && npm run check:json && npm run check:docs && npm run check:version && npm run check:hooks && npm run check:install && npm run check:project && npm run check:runner && npm run check:freshness && npm run check:resume && npm run check:handoff && npm run check:coordination && npm run check:packet && npm run check:preview",
    "check:js": "node scripts/check-js.js",
    "check:json": "node scripts/check-json.js",
    "check:docs": "node scripts/check-doc-links.js",
    "check:version": "node scripts/check-version-sync.js",
    "check:hooks": "node scripts/test-hooks.js",
    "changelog": "git-cliff --unreleased",
    "release": "node scripts/release.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "check:install": "node scripts/test-install.js",
    "check:project": "node scripts/test-project.js",
    "check:runner": "node scripts/test-runner.js",
    "check:freshness": "node scripts/test-freshness.js",
    "check:resume": "node scripts/test-resume.js",
    "check:handoff": "node scripts/test-task-handoff.js",
    "check:coordination": "node scripts/test-coordination.js",
    "check:packet": "node scripts/test-stage-packet.js",
    "smoke:host": "node scripts/smoke-host.js",
    "check:preview": "node scripts/test-preview.js",
    "smoke:installed": "node scripts/smoke-installed.js"
  },
  "devDependencies": {
    "git-cliff": "^2.13.1"
  },
  "license": "MIT"
}
