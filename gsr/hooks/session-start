#!/usr/bin/env node

/**
 * GSR Session Start Hook
 * Injects awareness of /gsr:* commands and project state into conversation context.
 * Runs on session start, resume, clear, and compact.
 */

const fs = require('fs');
const path = require('path');
const os = require('os');

let input = '';
let handled = false;
function once(data) { if (handled) return; handled = true; main(data); }
const stdinTimeout = setTimeout(() => once({}), 2000);
process.stdin.setEncoding('utf8');
process.stdin.on('data', c => (input += c));
process.stdin.on('end', () => {
  clearTimeout(stdinTimeout);
  let data = {};
  try { data = JSON.parse(input); } catch (e) { /* fall through */ }
  once(data);
});

function main(data) {
  const cwd = data.cwd || process.env.CLAUDE_PROJECT_DIR || process.cwd();

  // ── Auto-install / auto-refresh the statusline hook ─────────────────────
  const claudeDir = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude');
  const statuslineDst = path.join(claudeDir, 'hooks', 'gsr-statusline.js');
  let installedVersion = null;
  if (fs.existsSync(statuslineDst)) {
    const installed = fs.readFileSync(statuslineDst, 'utf8');
    const markerLine = installed.split('\n').slice(0, 2).find(line => line.startsWith('// gsr-hook-version:')) || '';
    const m = markerLine.match(/^\/\/ gsr-hook-version: (.+)$/);
    installedVersion = installed.startsWith('#!') && m ? m[1] : null;
  }
  let currentVersion = null;
  try {
    currentVersion = JSON.parse(fs.readFileSync(path.join(__dirname, '..', '.claude-plugin', 'plugin.json'), 'utf8')).version;
  } catch (e) { /* best-effort */ }
  if (!fs.existsSync(statuslineDst) || installedVersion !== currentVersion) {
    try {
      const installScript = path.join(__dirname, 'install.js');
      if (fs.existsSync(installScript)) {
        require('child_process').execFileSync(process.execPath, [installScript], { stdio: 'ignore' });
      }
    } catch (e) { /* best-effort */ }
  }

  let project;
  try { project = require('../lib/project').discover(cwd); }
  catch (e) { console.log(`<gsr-context>GSR: ${e.message}. Verification is unverified.</gsr-context>`); return; }
  const stateFile = path.join(project.docs, 'STATE.md');
  const isGsrProject = project.initialized;

  if (!isGsrProject) {
    console.log('<gsr-context>\nGSR (Get Shit Right) is available. To start:\n- New project: run /gsr:scope\n- Existing project: run /gsr:learn\n</gsr-context>');
    return;
  }
  let state = '';
  try { if (fs.existsSync(stateFile)) state = fs.readFileSync(stateFile, 'utf8'); }
  catch (e) { console.log(`<gsr-context>GSR state unavailable: ${e.message}</gsr-context>`); return; }
  const snippet = state.split('\n').slice(0, 20).join('\n').slice(0, 1400);
  const taskBlock = require('../lib/task-context').taskContext(project, state);
  const plansDir = path.join(project.docs, 'plans');
  const plans = [];
  if (fs.existsSync(plansDir)) {
    for (const file of fs.readdirSync(plansDir).filter(f => f.endsWith('.md')).sort()) {
      if (plans.length >= 5) break;
      try {
        const safe = require('../lib/project').resolveWithin(project.root, path.join(project.docRoot, 'plans', file), 'plan');
        const content = fs.readFileSync(safe, 'utf8');
        const fm = content.match(/^---\n([\s\S]*?)\n---/); if (!fm || !/^status:\s*in_progress\s*$/m.test(fm[1])) continue;
        const rows = content.split('\n').filter(l => /^\|\s*\d+\s*\|/.test(l));
        const done = rows.filter(l => /\|\s*done\s*\|/i.test(l)).length;
        const next = rows.find(l => !/\|\s*done\s*\|/i.test(l));
        const updated = fm[1].match(/^updated:\s*(.+)$/m)?.[1]?.trim();
        const old = updated && Date.now() - Date.parse(updated) > 7 * 86400000;
        plans.push(`Plan: ${project.docRoot}/plans/${file}; recorded progress ${done}/${rows.length}${old ? '; older than 7 days, inspect current files' : ''}${next ? `; next recorded task: ${next.split('|')[2]?.trim().slice(0, 250)}` : ''}. Reconcile recorded progress with actual files.`);
      } catch (e) { plans.push(`Plan ${file}: ${e.message}`); }
    }
  }
  console.log(`<gsr-context>
This is a GSR (Get Shit Right) project. Project: ${project.root}; DOC_ROOT: ${project.docRoot}.
${snippet ? `Current project state:\n${snippet}` : 'No STATE summary yet; inspect configured project files.'}
${taskBlock}
${plans.join('\n').slice(0, 1800)}
For an unambiguous saved task, after the user writes "dalej"/continue, load the internal coordinate skill and resume the indicated bounded step within original scope/cadence. Read only the listed relevant references first; reconcile actual files/evidence. This hook does not initiate work, clear context or grant authority. Later instructions win. Do not infer human acceptance from automated evidence.
</gsr-context>`);
}
